<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--
      This test project spins up a server using Nimblesite.Sync.Http library for WebApplicationFactory testing.
      Nimblesite.Sync.Http is a LIBRARY providing TOOLS - this test project tests those tools via an actual server.
    -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>Nimblesite.Sync.Http.Tests</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <NoWarn>CS1591;CA1707;CA1307;CA1062;CA1515;CA2100;CA1822;CA1859;CA1849;CA2234;CA1812;CA2007;CA2000;xUnit1030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.3.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nimblesite.Sync.Core/Nimblesite.Sync.Core.csproj" />
    <ProjectReference Include="../Nimblesite.Sync.SQLite/Nimblesite.Sync.SQLite.csproj" />
    <ProjectReference Include="../Nimblesite.Sync.Postgres/Nimblesite.Sync.Postgres.csproj" />
    <ProjectReference Include="../Nimblesite.Sync.Http/Nimblesite.Sync.Http.csproj" />
    <ProjectReference Include="../../Migration/DataProviderMigrate/DataProviderMigrate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="..\..\Tests.Shared\PostgresContainerFixture.cs"
      Link="Shared\PostgresContainerFixture.cs"
    />
    <Compile
      Include="..\..\Tests.Shared\PostgresCollection.cs"
      Link="Shared\PostgresCollection.cs"
    />
  </ItemGroup>
</Project>
