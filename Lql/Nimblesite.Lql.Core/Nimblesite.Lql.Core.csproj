<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <PackageId>Nimblesite.Lql.Core</PackageId>
    <!-- CS3021: CLSCompliant not needed (generated ANTLR code) -->
    <NoWarn>CA1515;CA1866;CA1310;CA1834;CS3021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ANTLR runtime (generated parser files are checked into git) -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Other/Nimblesite.Sql.Model/Nimblesite.Sql.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Implements [LQL-RENDER-SHARED]: keep the shared renderer internal. -->
    <InternalsVisibleTo Include="Nimblesite.Lql.Postgres" />
    <InternalsVisibleTo Include="Nimblesite.Lql.SQLite" />
    <InternalsVisibleTo Include="Nimblesite.Lql.SqlServer" />
  </ItemGroup>
</Project>
